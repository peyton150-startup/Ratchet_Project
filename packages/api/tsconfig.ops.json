// Operational scripts that import from src/ and must be runnable in the deployed image.
//
// tsconfig.scripts.json cannot compile these: its rootDir is ./scripts, so any import of
// ../src/* fails TS6059. Widening that rootDir would move migrate.js to dist/scripts/migrate.js
// and break both railway.json's preDeployCommand and migrate.ts's ../migrations lookup, so this
// is a separate config instead.
//
// rootDir is "." so scripts/ and src/ keep their relative positions in the output:
// dist/scripts/issueKey.js importing ../src/auth.js resolves to dist/src/auth.js. Emitting to
// dist/issueKey.js instead would leave that import pointing at the TypeScript source directory —
// output that compiles and cannot start.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["scripts/issueKey.ts"],
  "exclude": ["node_modules", "dist"]
}
