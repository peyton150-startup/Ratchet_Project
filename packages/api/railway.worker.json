{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @workspace/sdk build && pnpm --filter @workspace/api build",
    "watchPatterns": ["packages/api/**", "packages/sdk/**"]
  },
  "deploy": {
    "startCommand": "node packages/api/dist/pipeline/worker.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
